# Copy to .env and fill in. Never commit .env.

# --- Shopify (Dev Dashboard app, client credentials grant) ---
SHOPIFY_STORE_DOMAIN=e91eee-4.myshopify.com
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# Latest stable Admin API version — check https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2026-10

# --- Draft orders ---
# Comma-separated tags added to every draft order. Use "test" during development; leave blank in production.
DRAFT_ORDER_TAGS=test

# --- Email (Gmail SMTP, port 465) ---
SMTP_USER=sales@roofvents.com
# Gmail app password (NOT the account password). Use a NEW one; the old one must be rotated.
SMTP_PASS=
MAIL_FROM=sales@roofvents.com
MAIL_FROM_NAME=Active Ventilation Products
# Timezone used to format the order date in the email
STORE_TIMEZONE=America/New_York
# Dev only: send every confirmation email here instead of to the customer. Leave blank in production.
TEST_EMAIL_OVERRIDE=

# --- CORS ---
# Comma-separated origins allowed to call the endpoint
ALLOWED_ORIGINS=https://roofvents.com,https://www.roofvents.com,http://127.0.0.1:9292

# --- Local testing only (scripts/local-test.js) ---
# A real variant ID from the store (number only), used to build the sample cart
TEST_VARIANT_ID=
