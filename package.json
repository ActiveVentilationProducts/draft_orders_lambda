{
  "name": "draft-orders-lambda",
  "version": "1.0.0",
  "private": true,
  "description": "Request-a-quote endpoint for roofvents.com: creates a Shopify draft order and emails the customer.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test:local": "node --env-file=.env scripts/local-test.js",
    "dev": "node --env-file=.env scripts/dev-server.js",
    "build": "node scripts/build.js",
    "zip": "powershell -NoProfile -Command \"Compress-Archive -Path dist/index.mjs -DestinationPath dist/function.zip -Force\""
  },
  "dependencies": {
    "nodemailer": "^10.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
